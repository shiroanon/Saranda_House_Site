# Local development only.
#
# On Appwrite Sites you do NOT need any of these: Appwrite injects
# APPWRITE_SITE_API_ENDPOINT and APPWRITE_SITE_PROJECT_ID at runtime, and sends a
# short-lived admin key on the `x-appwrite-key` header of every SSR request.

# Your project's regional endpoint, e.g. https://fra.cloud.appwrite.io/v1
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# The project ID from the Appwrite Console.
APPWRITE_PROJECT_ID=

# Server-only API key (never expose it to the browser). Needs at minimum the
# `sessions.write` scope for login; add `users.write` if you use server-side
# registration helpers such as Users.create.
APPWRITE_API_KEY=
